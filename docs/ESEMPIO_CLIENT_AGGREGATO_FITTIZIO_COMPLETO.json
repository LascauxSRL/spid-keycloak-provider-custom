{
  "clientId": "soggetto-aggregato-fittizio-completo",
  "name": "Soggetto Aggregato Fittizio - Configurazione Completa",
  "description": "Client di test con tutti gli attributi configurati per collaudo tecnico completo",
  "enabled": true,
  "protocol": "saml",
  "attributes": {
    "saml.force.post.binding": "false",
    "saml.artifact.binding": "false",
    "saml.server.signature": "true",
    "saml.server.signature.keyinfo.ext": "false",
    "saml.force.name.id.format": "false",
    "saml.multivalued.roles": "false",
    "saml.encrypt": "false",
    "saml.client.signature": "false",
    "saml.authnstatement": "true",
    "saml.onetimeuse.condition": "false",
    "saml_force_name_id_format": "false",
    "saml.signature.algorithm": "RSA_SHA256",
    "saml.signature.canonicalization.method": "http://www.w3.org/2001/10/xml-exc-c14n#",
    
    "spid.entityId": "https://soggetto-fittizio-completo.example.com/spid",
    
    "spid.organizationNames": "it|Soggetto Aggregato Fittizio Completo S.r.l.|en|Fictitious Aggregated Subject Complete Ltd.",
    "spid.organizationDisplayNames": "it|Soggetto Fittizio Completo|en|Fictitious Subject Complete",
